RewriteEngine on 
AddHandler application/x-httpd-php71 .php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]
AcceptPathInfo Off
IndexIgnore *
Options -Indexes
 ErrorDocument 404 https://edocohest.edu.ng/404
 RewriteCond %{REQUEST_URI} ^/404/$
 RewriteRule ^(.*)$ https://edocohest.edu.ng/404 [L] 
RewriteEngine On
